<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android can only toggle cleartext at manifest / domain granularity, not
         by resolved IP range. LanGuard.kt applies the real policy at runtime:
         ws:// is allowed only when the hub resolves to a local-network address;
         any public host must use wss://. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
